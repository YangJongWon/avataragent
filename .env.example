# AI 제공자: mock(키 없이 시뮬레이션) | agents | openai | anthropic | gemini | xai
#   agents: 직원마다 고용 탭에서 고른 모델(모자)의 회사 API로 호출. 모델 ID·단가는 shared/models.ts
#   openai/anthropic/gemini/xai: 모든 직원을 아래 AI_MODEL 하나로 호출
AI_PROVIDER=mock

# 사용할 모델 이름 (agents·mock 에서는 무시)
AI_MODEL=

# 제공자별 API 키 (사용하는 것만 입력)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# 모델 단가 (USD / 100만 토큰). AI_MODEL 하나로 호출할 때만 사용
PRICE_INPUT_PER_MTOK_USD=1
PRICE_OUTPUT_PER_MTOK_USD=4

# 환율 (원 / 달러)
USD_KRW=1400

# 월 AI 예산(원)과 인건비 환산 시급(원). 화면의 손익·결산 탭에서도 바꿀 수 있음
MONTHLY_BUDGET_KRW=50000
HOURLY_RATE_KRW=30000

# 도움 요청에 응답이 없을 때 가정으로 진행하기까지의 시간(초)
HELP_TIMEOUT_SEC=180

# mock 모드에서 단계별 지연(ms)
MOCK_DELAY_MS=2500

# 접속 비밀번호. 비워 두면 비밀번호 없이 열림. 외부 공개 시 반드시 설정
ACCESS_PASSWORD=

# 공유 링크·QR에 넣을 외부 주소 (예: Tailscale Funnel 주소). 비우면 지금 연 주소를 씀
PUBLIC_URL=

PORT=8787
AUTO_RUN_INTERVAL_SEC=30
# DATA_DIR=data
# AI 호출 안정성 (밀리초, 재시도 횟수)
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=750

# MCP: 이 PC에서 명령으로 띄우는 MCP 서버(npx·uvx)를 허용하려면 1. 외부 공개 중이면 긴 비밀번호와 함께 켤 것
# MCP_ALLOW_STDIO=1
# MCP_TIMEOUT_MS=30000

# 업무 실행기: local(기본) 또는 temporal(골격, 단계 실행 미연결 — 개발용)
# WORKFLOW_RUNTIME=local
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=avataragent-tasks

# 비워 두면 SQLite(data/office.db), 설정하면 PostgreSQL을 기준 저장소로 사용합니다.
# 로컬 Docker 개발 DB: postgresql://avataragent:avataragent_dev@localhost:55432/avataragent
# DATABASE_URL=
