# AI 제공자: mock(키 없이 시뮬레이션) | agents | openai | anthropic | gemini | xai
#   agents: 직원마다 고용 탭에서 고른 모델(모자)의 회사 API로 호출. 모델 ID·단가는 shared/models.ts
#   openai/anthropic/gemini/xai: 모든 직원을 아래 AI_MODEL 하나로 호출
AI_PROVIDER=mock

# 사용할 모델 이름 (agents·mock 에서는 무시)
AI_MODEL=

# 제공자별 API 키 (사용하는 것만 입력)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# OpenRouter 무료 모델용 키. 화면의 모델 관리에서 저장해도 됩니다.
OPENROUTER_API_KEY=

# 모델 단가 (USD / 100만 토큰). AI_MODEL 하나로 호출할 때만 사용
PRICE_INPUT_PER_MTOK_USD=1
PRICE_OUTPUT_PER_MTOK_USD=4

# 환율 (원 / 달러)
USD_KRW=1400

# 월 AI 예산(원)과 인건비 환산 시급(원). 화면의 손익·결산 탭에서도 바꿀 수 있음
MONTHLY_BUDGET_KRW=50000
HOURLY_RATE_KRW=30000

# 도움 요청에 응답이 없을 때 가정으로 진행하기까지의 시간(초)
HELP_TIMEOUT_SEC=180

# mock 모드에서 단계별 지연(ms)
MOCK_DELAY_MS=2500

# 결과물 "고품질" 화면 검수: LibreOffice(soffice) 경로. 비우면 기본 설치 위치와 PATH에서 찾음
SOFFICE_PATH=
# 화면 검수 → 수정 반복 횟수(1~3)
DESIGN_REVIEW_ROUNDS=2

# 접속 비밀번호. 비워 두면 비밀번호 없이 열림. 외부 공개 시 반드시 설정
ACCESS_PASSWORD=

# 결제 연결. 비우면 플랜을 바로 바꿈, mock 은 가짜 결제 화면으로 전체 흐름을 시험,
# site 는 공식 사이트에서 플랜 라이선스를 사서 이 설치에 적용
BILLING_PROVIDER=
# 결제사 웹훅 서명 비밀키 (mock 은 비워도 됨)
BILLING_WEBHOOK_SECRET=
# 프로젝트 사이트 주소. 커뮤니티 탭(테마·흐름·플레이북 설치)과 BILLING_PROVIDER=site 의 라이선스 구매에 씀
SITE_URL=
# 추가로 믿을 라이선스 공개키 (개인 사이트를 띄울 때). JSON: {"kid": "PEM"}
LICENSE_PUBLIC_KEYS=

# 공유 링크·QR에 넣을 외부 주소 (예: Tailscale Funnel 주소). 비우면 지금 연 주소를 씀
PUBLIC_URL=

PORT=8787
AUTO_RUN_INTERVAL_SEC=30
# DATA_DIR=data
# AI 호출 안정성 (밀리초, 재시도 횟수)
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=750

# MCP: 이 PC에서 명령으로 띄우는 MCP 서버(npx·uvx)를 허용하려면 1. 외부 공개 중이면 긴 비밀번호와 함께 켤 것
# 직접 입력한 실행 명령 MCP를 이 PC가 아닌 곳(외부 주소)에서도 등록하게 하려면 1. 기본 제공 연결과 이 PC에서의 등록은 없어도 됨
# MCP_ALLOW_STDIO=1
# MCP_TIMEOUT_MS=30000

# 업무 실행기: local(기본) 또는 temporal(골격, 단계 실행 미연결 — 개발용)
# WORKFLOW_RUNTIME=local
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=avataragent-tasks

# 비워 두면 SQLite(data/office.db), 설정하면 PostgreSQL을 기준 저장소로 사용합니다.
# 로컬 Docker 개발 DB: postgresql://avataragent:avataragent_dev@localhost:55432/avataragent
# DATABASE_URL=

# 저장 데이터의 소속(회사). 같은 DB를 여러 서버가 쓸 때 서버마다 다르게 정합니다. 같은 값으로는 서버 하나만 켤 수 있습니다.
# TENANT_ID=default
# Optional exchange-rate endpoint returning Frankfurter-compatible KRW/JPY JSON.
# EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v2/rate/KRW/JPY
